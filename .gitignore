/pdf-output/
/assets/pdf/*
!/assets/pdf/README.md

# Link checker cache
.link-cache.json

# Local logs for scripts/pace-agents.js (reviews, patches, lock, state)
/logs/

# Generated search index (built into _site/search_index.json on every build)
search_index.json

# flock file created by scripts/review_solutions.py --record
/doc/solution-review/reviews.lock
