/resources/*.dbk
/resources/*.jar
/resources/unifiedfile*
/resources/*.html
/resources/*.txt
/node_modules
/zips


/.ipynb_checkpoints/

# Build output
/_site/

# Ignore folders generated by Bundler (legacy)
/.bundle/
/vendor/
/bin/

# Ignore intellij
/.idea/
/.mypy_cache/
__pycache__/

